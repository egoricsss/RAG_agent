# Шаблон конфигурации для docker compose.
#   cp .env.example .env && chmod 600 .env
# Файл .env читает docker compose и передаёт переменные в контейнер.
# Сам код .env не загружает, поэтому переменные должны попасть в окружение процесса.

# --- OpenRouter (обязательно) ---
# Ключ из https://openrouter.ai/keys. Не коммитьте и не публикуйте его.
OPENROUTER_API_KEY=

# --- Модели (необязательно, значения по умолчанию указаны) ---
# Модель ответов; нужны structured outputs.
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash
# Модель эмбеддингов. Обязана совпадать с той, что использовалась при создании
# chroma_db, иначе агент откажется стартовать с ошибкой о несовпадении модели.
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# Модель распознавания фото в боте; должна принимать изображения и JSON Schema.
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# --- Telegram (обязательно) ---
# Токен от @BotFather.
TELEGRAM_BOT_TOKEN=
# Ваш числовой Telegram ID (не username): администратор доступа.
TELEGRAM_SUPER_ADMIN_ID=
# Необязательно: стартовые ID участников через запятую. Читается только при
# создании базы доступа; позже управление идёт командами бота.
TELEGRAM_ALLOWED_USER_IDS=

# --- ChromaDB (необязательно) ---
# Имя коллекции в базе знаний.
CHROMA_COLLECTION=compilers_kb

# Пути внутри контейнера задаёт docker-compose.yml — не переопределяйте их здесь:
#   CHROMA_DB_PATH=/app/chroma_db
#   TELEGRAM_ACCESS_DB_PATH=/app/data/telegram_access.sqlite3
